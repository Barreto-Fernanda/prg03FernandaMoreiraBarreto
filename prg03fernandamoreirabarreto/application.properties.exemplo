# Nome da aplica\u00e7\u00e3o (informativo)
spring.application.name=prg03fernandamoreirabarreto

# ---- CONEX\u00c3O COM O BANCO (antes ficava no persistence.xml) ----
# URL do banco. Em .properties o & \u00e9 escrito normalmente (no XML era &amp;)
spring.datasource.url=jdbc:mysql://localhost:3306/prg03_projeto?createDatabaseIfNotExist=true&useTimezone=true&serverTimezone=UTC
# Usu\u00e1rio do banco
spring.datasource.username=root
# Senha do banco: ESTE ARQUIVO N\u00c3O PODE IR PARA O GITHUB
spring.datasource.password=SUA SENHA AQUI
# Driver do MySQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ---- HIBERNATE ----
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.show_sql=true
# validate: o Hibernate s\u00f3 confere se as tabelas batem; quem cria e altera tabela \u00e9 o Flyway
spring.jpa.properties.hibernate.hbm2ddl.auto=validate
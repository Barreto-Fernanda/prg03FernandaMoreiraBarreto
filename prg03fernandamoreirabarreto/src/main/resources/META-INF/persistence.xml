<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- Só o que identifica a unidade e as entidades. URL, usuário, senha e as
         propriedades do Hibernate agora vêm do application.properties (lidas pelo JPAUtil) -->
    <persistence-unit name="prg03PU" transaction-type="RESOURCE_LOCAL">
        <class>br.com.ifba.usuario.entity.Usuario</class>
    </persistence-unit>
</persistence>